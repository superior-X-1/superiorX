# ==============================================================================
# Measure X (SuperiorX) Backend — Environment Configuration Template
# Production Architecture: Render (FastAPI) + Supabase (PostgreSQL + Storage)
# ==============================================================================

# Database (Supabase PostgreSQL / Local Fallback)
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=measurex
DB_USER=root
DB_PASSWORD=

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=measurex-storage

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Cryptographic Digital Signature (RSA-2048)
DIGITAL_SIGNATURE_PRIVATE_KEY_PEM=
DIGITAL_SIGNATURE_PUBLIC_KEY_PEM=
DIGITAL_SIGNATURE_KEY_ID=MX-KEY-2026-V1

# QR Verification Base URL
PUBLIC_VERIFY_BASE_URL=https://your-app.vercel.app/#verify?id=
