# ==============================================================================
# Measure X — Environment Configuration Template
# Digital Legal Metrology Platform (SIH26036)
# ==============================================================================

# MySQL 8+ / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=measurex
DB_USER=root
DB_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Cross-Origin Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cryptographic Signing (RSA-2048 Asymmetric Signature PKCS#1 v1.5)
SIGNING_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public.pem
KEY_ID=MEASUREX-RSA2048-2026-v1

# Public Verification Base URL (for ISO/IEC 18004 QR Codes)
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/#verify?id=

# Storage Directory for Documents and Field Evidence
UPLOAD_DIR=uploads
