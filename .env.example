# ==============================================================================
# Measure X (SuperiorX) — Environment Configuration Template
# Production Architecture: Vercel (Frontend) + Render (FastAPI) + Supabase (PostgreSQL + Storage)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# Production: Set DATABASE_URL to your Supabase PostgreSQL connection string.
# Example: postgresql+psycopg://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Or direct: postgresql+psycopg://postgres:your_password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Local Development Fallback (MySQL / SQLite):
# If DATABASE_URL is not set, the backend falls back to local MySQL or SQLite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=measurex
DB_USER=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Document & Inspection Evidence Uploads)
# ------------------------------------------------------------------------------
# In production on Render, set these from your Supabase Project Settings -> API & Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=measurex-storage

# Local Storage Fallback: If Supabase credentials are not provided, files are saved locally to storage/uploads/
FILE_STORAGE_PATH=storage/uploads

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins (include your Vercel frontend URL)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC ASYMMETRIC SIGNING (RSA-2048 PKCS#1 v1.5 + SHA-256)
# ------------------------------------------------------------------------------
# Production: Paste the private key PEM into DIGITAL_SIGNATURE_PRIVATE_KEY_PEM env var
# Never commit private keys to the repository.
DIGITAL_SIGNATURE_PRIVATE_KEY_PEM=
DIGITAL_SIGNATURE_PUBLIC_KEY_PEM=
DIGITAL_SIGNATURE_KEY_ID=MX-KEY-2026-V1

# ------------------------------------------------------------------------------
# 6. PUBLIC VERIFICATION QR CODE BASE URL
# ------------------------------------------------------------------------------
PUBLIC_VERIFY_BASE_URL=https://your-app.vercel.app/#verify?id=
